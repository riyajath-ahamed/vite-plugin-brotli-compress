{
  "name": "vite-plugin-brotli-compress",
  "version": "1.2.0",
  "description": "A Vite plugin to compress build assets using Brotli, built with tsdown.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --format cjs,esm --dts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "prepublishOnly": "npm run build && npm run test:run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/riyajath-ahamed/vite-plugin-brotli-compress.git"
  },
  "keywords": [
    "vite",
    "vite-plugin",
    "compress",
    "brotli",
    "react",
    "typescript"
  ],
  "author": "riyajath-ahamed <riyajath.ahamed@gmail.com> (https://github.com/riyajath-ahamed)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/riyajath-ahamed/vite-plugin-brotli-compress/issues"
  },
  "homepage": "https://github.com/riyajath-ahamed/vite-plugin-brotli-compress#readme",
  "peerDependencies": {
    "vite": ">=4.0.0 <8.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "@vitest/coverage-v8": "^4.1.4",
    "@vitest/ui": "^4.1.4",
    "tsdown": "^0.21.7",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "^1.0.0-rc.12"
  },
  "overrides": {
    "vitest": {
      "vite": "^7.3.2"
    }
  }
}
